# Copy to .env.local (local) and add the same values in Vercel → Settings → Environment Variables.
# Without the Supabase vars the app runs on an in-memory store (data resets on restart).

# --- Required ---
ADMIN_PASSWORD=choose_a_long_treasurer_password
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase "service_role" key (or the newer "secret" key, sb_secret_...). Server-only — never share it.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Optional ---
# Receipt scanning. Without it everything else works; Scan Receipt shows "not configured".
GEMINI_API_KEY=your_google_ai_studio_api_key
# Optional model override; default tries gemini-3.5-flash-lite, then gemini-3.1-flash-lite, then gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.5-flash-lite
# Separate secret for signing Treasurer sessions (defaults to ADMIN_PASSWORD).
# SESSION_SECRET=a_long_random_string
# Vercel only: lets just Vercel Cron call /api/keepalive (daily ping that stops Supabase Free pausing).
# CRON_SECRET=a_long_random_string
# Only if link previews show the wrong address (defaults to the Vercel production domain).
# SITE_URL=https://trip.example.com
# Not read by the app (all data goes through the server); listed only because the original spec named it.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
